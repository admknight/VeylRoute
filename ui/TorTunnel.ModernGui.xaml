<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VeylRoute Control Center v3.0 Windows RC1" Width="1230" Height="850" MinWidth="990" MinHeight="690"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="TT.Background" Color="#081322"/>
    <SolidColorBrush x:Key="TT.Sidebar" Color="#0D2036"/>
    <SolidColorBrush x:Key="TT.Surface" Color="#142B48"/>
    <SolidColorBrush x:Key="TT.SurfaceAlt" Color="#203C5A"/>
    <SolidColorBrush x:Key="TT.Border" Color="#365576"/>
    <SolidColorBrush x:Key="TT.Text" Color="#F2F7FC"/>
    <SolidColorBrush x:Key="TT.Muted" Color="#B5CDE5"/>
    <SolidColorBrush x:Key="TT.Accent" Color="#52D5F1"/>
    <SolidColorBrush x:Key="TT.AccentText" Color="#061D25"/>
    <SolidColorBrush x:Key="TT.Warning" Color="#FFC06D"/>
    <SolidColorBrush x:Key="TT.Danger" Color="#FF7286"/>
    <SolidColorBrush x:Key="TT.Glow" Color="#17496A"/>
    <SolidColorBrush x:Key="TT.Hero" Color="#12395A"/>
    <SolidColorBrush x:Key="TT.Highlight" Color="#9674FF"/>
    <SolidColorBrush x:Key="TT.InputHover" Color="#6BA2CA"/>
    <SolidColorBrush x:Key="TT.SelectChosen" Color="#294B70"/>
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TT.Text}"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TT.Text}"/>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource TT.Muted}"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="CornerRadius" Value="15"/><Setter Property="Padding" Value="20"/>
      <Setter Property="Background" Value="{DynamicResource TT.Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource TT.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="BaseButton" TargetType="Button">
      <Setter Property="Height" Value="39"/><Setter Property="MinWidth" Value="90"/>
      <Setter Property="Padding" Value="16,0"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TT.Text}"/>
      <Setter Property="Background" Value="{DynamicResource TT.SurfaceAlt}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource TT.Border}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="9" BorderThickness="{TemplateBinding BorderThickness}"
                    BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.83"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.67"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.37"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="{DynamicResource TT.Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource TT.AccentText}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Foreground" Value="{DynamicResource TT.Danger}"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Height" Value="44"/><Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="17,0"/><Setter Property="MinWidth" Value="0"/>
      <Setter Property="Background" Value="{DynamicResource TT.Sidebar}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource TT.Text}"/>
      <Setter Property="Background" Value="{DynamicResource TT.SurfaceAlt}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource TT.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,9"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource TT.Highlight}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TT.Accent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="InputChrome" CornerRadius="10" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="InputChrome" Property="BorderBrush" Value="{DynamicResource TT.InputHover}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="InputChrome" Property="BorderBrush" Value="{DynamicResource TT.Accent}"/>
                <Setter TargetName="InputChrome" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputChrome" Property="Opacity" Value="0.55"/></Trigger>
              <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="InputChrome" Property="Opacity" Value="0.94"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SelectItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TT.Text}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="13,10"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="OptionChrome" CornerRadius="7" Margin="4,2" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" ContentSource="Content"
                                RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="OptionChrome" Property="Background" Value="{DynamicResource TT.Glow}"/>
                <Setter Property="Foreground" Value="{DynamicResource TT.Accent}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="OptionChrome" Property="Background" Value="{DynamicResource TT.SelectChosen}"/>
                <Setter Property="Foreground" Value="{DynamicResource TT.Text}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ControlTemplate x:Key="SelectToggle" TargetType="ToggleButton">
      <Border x:Name="ComboChrome" Background="{DynamicResource TT.SurfaceAlt}" BorderBrush="{DynamicResource TT.Border}"
              BorderThickness="1" CornerRadius="10" SnapsToDevicePixels="True">
        <Grid>
          <Path Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource TT.Muted}" StrokeThickness="1.8"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource TT.InputHover}"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource TT.Accent}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboChrome" Property="Opacity" Value="0.43"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Select" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource TT.Text}"/>
      <Setter Property="Background" Value="{DynamicResource TT.SurfaceAlt}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource TT.Border}"/>
      <Setter Property="Height" Value="41"/>
      <Setter Property="MaxDropDownHeight" Value="290"/>
      <Setter Property="Padding" Value="14,0,35,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource SelectItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="ComboToggle" Template="{StaticResource SelectToggle}" Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            ClickMode="Press"/>
              <ContentPresenter x:Name="SelectionText" IsHitTestVisible="False"
                                Margin="14,0,36,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                RecognizesAccessKey="True"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <Border x:Name="PopupChrome" Background="{DynamicResource TT.Surface}" BorderBrush="{DynamicResource TT.Border}"
                          BorderThickness="1" CornerRadius="10" Padding="3" Margin="0,5,0,0">
                    <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto" KeyboardNavigation.DirectionalNavigation="Contained">
                      <ItemsPresenter/>
                    </ScrollViewer>
                  </Border>
                </Grid>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SelectionText" Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Option" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TT.Text}"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,6,0,6"/>
    </Style>
    <Style x:Key="FieldTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TT.Muted}"/>
      <Setter Property="Margin" Value="0,0,0,7"/><Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>
  <Grid Background="{DynamicResource TT.Background}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <!-- Navigation -->
    <Border Grid.Column="0" Background="{DynamicResource TT.Sidebar}" BorderBrush="{DynamicResource TT.Border}" BorderThickness="0,0,1,0">
      <DockPanel Margin="18,24,18,18">
        <StackPanel DockPanel.Dock="Top" Margin="5,0,5,30">
          <StackPanel Orientation="Horizontal">
            <Border Width="39" Height="39" Background="{DynamicResource TT.Accent}" CornerRadius="11" Margin="0,0,11,0" ToolTip="VeylRoute privacy routing emblem">
              <Viewbox Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="64" Height="64">
                  <Path Data="M9,42 C9,22 19,10 32,10 C45,10 55,22 55,42" Stroke="{DynamicResource TT.AccentText}" StrokeThickness="5.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                  <Path Data="M19,42 C19,30 24,21 32,21 C40,21 45,30 45,42" Stroke="{DynamicResource TT.AccentText}" StrokeThickness="5.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                  <Path Data="M28,43 L28,38 C28,32 36,32 36,38 L36,43" Stroke="{DynamicResource TT.AccentText}" StrokeThickness="5.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                  <Path Data="M12,52 L52,52" Stroke="{DynamicResource TT.AccentText}" StrokeThickness="5.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                </Canvas>
              </Viewbox>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="VeylRoute" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TT.Text}"/>
              <TextBlock Text="CONTROL CENTER" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TT.Muted}"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
          <Separator Background="{DynamicResource TT.Border}" Margin="0,0,0,12"/>
          <Button Name="BtnSetupGuide" Style="{StaticResource NavButton}" AutomationProperties.Name="Open setup guide"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="16" Height="16" Margin="0,0,9,0" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M8,9 A4,4 0 1 1 13,13 L12,16 M12,20 L12.1,20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" StrokeStartLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Text="Setup guide" VerticalAlignment="Center"/></StackPanel></Button>
          <Button Name="BtnExitGui" Style="{StaticResource NavButton}" AutomationProperties.Name="Exit GUI without disconnecting"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="16" Height="16" Margin="0,0,9,0" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M9,4 L5,4 5,20 9,20 M16,8 L20,12 16,16 M20,12 L10,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Text="Exit GUI" VerticalAlignment="Center"/></StackPanel></Button>
          <Button Name="BtnTheme" Style="{StaticResource NavButton}" AutomationProperties.Name="Switch theme"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="16" Height="16" Margin="0,0,9,0" Stretch="Uniform" SnapsToDevicePixels="True"><Canvas Width="24" Height="24"><Path Data="M19,17 A8,8 0 0 1 7,5 A8,8 0 1 0 19,17 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.85" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Name="LblTheme" Text="Switch theme" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button>
          <TextBlock Text="VEYLROUTE v3.0 WINDOWS RC1" FontSize="10" Foreground="{DynamicResource TT.Muted}" Margin="12,10,0,0"/>
          <TextBlock Text="ENGINE v3.5.1" FontSize="10" Foreground="{DynamicResource TT.Muted}" Margin="12,3,0,0"/>
          <TextBlock Text="&#169; 2026 Zahid Hussain / Scopewise Consulting" FontSize="10" Foreground="{DynamicResource TT.Muted}" TextWrapping="Wrap" Margin="12,7,0,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="WORKSPACE" Style="{StaticResource MutedText}" Margin="12,0,0,9"/>
            <Button Name="NavDashboard" Style="{StaticResource NavButton}" AutomationProperties.Name="Overview"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="18" Height="18" Margin="0,0,12,0" Stretch="Uniform" SnapsToDevicePixels="True"><Canvas Width="24" Height="24"><Path Data="M3,3 L10,3 10,10 3,10 Z M14,3 L21,3 21,8 14,8 Z M14,12 L21,12 21,21 14,21 Z M3,14 L10,14 10,21 3,21 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.85" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Name="LblNavDashboard" Text="Overview" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button>
            <Button Name="NavCountries" Style="{StaticResource NavButton}" AutomationProperties.Name="Exit locations"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="18" Height="18" Margin="0,0,12,0" Stretch="Uniform" SnapsToDevicePixels="True"><Canvas Width="24" Height="24"><Path Data="M12,21 C9,17 5,13 5,9 A7,7 0 1 1 19,9 C19,13 15,17 12,21 Z M9.5,9 A2.5,2.5 0 1 1 14.5,9 A2.5,2.5 0 1 1 9.5,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.85" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Name="LblNavCountries" Text="Exit locations" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button>
            <Button Name="NavDns" Style="{StaticResource NavButton}" AutomationProperties.Name="DNS protection"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="18" Height="18" Margin="0,0,12,0" Stretch="Uniform" SnapsToDevicePixels="True"><Canvas Width="24" Height="24"><Path Data="M12,2 L20,6 20,12 C20,17 16.5,20 12,22 C7.5,20 4,17 4,12 L4,6 Z M8,12 L11,15 16,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.85" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Name="LblNavDns" Text="DNS protection" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button>
            <Button Name="NavApps" Style="{StaticResource NavButton}" AutomationProperties.Name="Direct applications"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="18" Height="18" Margin="0,0,12,0" Stretch="Uniform" SnapsToDevicePixels="True"><Canvas Width="24" Height="24"><Path Data="M4,4 L20,4 20,20 4,20 Z M4,9 L20,9 M8,6.5 L8.5,6.5 M11,6.5 L11.5,6.5 M9,13 L13,13 13,17 9,17 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.85" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Name="LblNavApps" Text="Application routing" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button>
            <Button Name="NavBridges" Style="{StaticResource NavButton}" AutomationProperties.Name="obfs4 bridges"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="18" Height="18" Margin="0,0,12,0" Stretch="Uniform" SnapsToDevicePixels="True"><Canvas Width="24" Height="24"><Path Data="M3,4 L9,4 9,10 3,10 Z M15,14 L21,14 21,20 15,20 Z M9,7 L14,7 14,17 15,17 M3,14 L9,14 9,20 3,20 Z M9,17 L15,17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.85" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Name="LblNavBridges" Text="obfs4 bridges" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button>
            <Button Name="NavSecurity" Style="{StaticResource NavButton}" AutomationProperties.Name="Advanced settings"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="18" Height="18" Margin="0,0,12,0" Stretch="Uniform" SnapsToDevicePixels="True"><Canvas Width="24" Height="24"><Path Data="M4,6 L20,6 M4,12 L20,12 M4,18 L20,18 M9,4 L9,8 M16,10 L16,14 M11,16 L11,20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.85" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Name="LblNavSecurity" Text="Advanced settings" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button>
            <TextBlock Text="OPERATIONS" Style="{StaticResource MutedText}" Margin="12,18,0,9"/>
            <Button Name="NavUpdates" Style="{StaticResource NavButton}" AutomationProperties.Name="Versions &amp; updates"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="18" Height="18" Margin="0,0,12,0" Stretch="Uniform" SnapsToDevicePixels="True"><Canvas Width="24" Height="24"><Path Data="M20,7 A8,8 0 0 0 6,5 M6,5 L6,10 M6,5 L11,5 M4,17 A8,8 0 0 0 18,19 M18,19 L18,14 M18,19 L13,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.85" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Name="LblNavUpdates" Text="Versions &amp; updates" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button>
            <Button Name="NavActivity" Style="{StaticResource NavButton}" AutomationProperties.Name="Activity log"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="18" Height="18" Margin="0,0,12,0" Stretch="Uniform" SnapsToDevicePixels="True"><Canvas Width="24" Height="24"><Path Data="M8,5 L21,5 M8,11 L21,11 M8,17 L21,17 M3,5 L4,5 M3,11 L4,11 M3,17 L4,17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.85" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Name="LblNavActivity" Text="Activity log" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button>
            <Button Name="NavMaintenance" Style="{StaticResource NavButton}" AutomationProperties.Name="Maintenance"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="18" Height="18" Margin="0,0,12,0" Stretch="Uniform" SnapsToDevicePixels="True"><Canvas Width="24" Height="24"><Path Data="M14,5 A6,6 0 0 0 21,11 L17.5,7.5 15,10 17.5,12.5 21,9 A6,6 0 0 1 14,16 L8,22 L3,17 L9,11 A6,6 0 0 1 14,5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.85" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Name="LblNavMaintenance" Text="Maintenance" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <!-- Content region -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="56"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{DynamicResource TT.Background}" BorderBrush="{DynamicResource TT.Border}" BorderThickness="0,0,0,1">
        <Grid Margin="29,0,28,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Name="HeaderTitle" Text="Overview" Style="{StaticResource H2}"/>
            <TextBlock Name="HeaderSubtitle" Text="Connection and system health at a glance" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource TT.Warning}" Margin="0,0,9,0"/>
            <TextBlock Name="HeaderState" Text="CHECKING" Foreground="{DynamicResource TT.Muted}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="28,19,28,16">
        <!-- Dashboard -->
        <ScrollViewer Name="PageDashboard" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,12">
            <Border Style="{StaticResource Card}" Padding="24" Background="{DynamicResource TT.Surface}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
