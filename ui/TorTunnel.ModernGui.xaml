        </ScrollViewer>
        <!-- Bridges -->
        <ScrollViewer Name="PageBridges" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,10">
            <DockPanel LastChildFill="True"><Border Name="ChipBridges" DockPanel.Dock="Right" Padding="10,5" CornerRadius="9" Margin="12,0,0,0"><TextBlock Name="StateBridges" Text="Checking" FontWeight="SemiBold" FontSize="11"/></Border><TextBlock Text="obfs4 bridge entries" Style="{StaticResource H1}" VerticalAlignment="Center"/></DockPanel>
            <TextBlock Text="Edit your existing bridge lines. Keep the fingerprint and certificate material intact. Only structurally valid obfs4 entries can be saved." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,16"/>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Bridge configuration" Style="{StaticResource FieldTitle}"/>
              <TextBox Name="TxtBridges" Style="{StaticResource Input}" MinHeight="300" Height="320" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto"/>
              <TextBlock Text="If no bridges are available, request fresh obfs4 lines through the official Tor Project page. No bridge details are generated or fetched automatically." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0"/>
              <WrapPanel Margin="0,13,0,0"><Button Name="BtnPasteBridges" Content="Paste from clipboard" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Paste obfs4 bridge lines from the clipboard"/><Button Name="BtnGetBridges" Content="Get obfs4 bridges" Style="{StaticResource BaseButton}" AutomationProperties.Name="Get obfs4 bridges from Tor Project"/><Button Name="BtnValidateBridges" Style="{StaticResource BaseButton}" AutomationProperties.Name="Validate format"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="16" Height="16" Margin="0,0,9,0" Stretch="Uniform" SnapsToDevicePixels="True"><Canvas Width="24" Height="24"><Path Data="M4,12 L10,18 20,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.85" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Name="LblBtnValidateBridges" Text="Validate format" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button></WrapPanel>
              <TextBlock Name="BridgeCount" Text="--" Style="{StaticResource MutedText}" Margin="0,11,0,0" TextWrapping="Wrap"/>
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
        <!-- Security -->
        <ScrollViewer Name="PageSecurity" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,10">
            <TextBlock Text="Security &amp; network settings" Style="{StaticResource H1}"/>
            <TextBlock Text="Advanced options are locked while a tunnel session exists. Changing fail-closed protections can expose traffic outside Tor." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,16"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Leak &amp; browser protection" Style="{StaticResource H2}" Margin="0,0,0,16"/>
                <CheckBox Name="CbBlockPlainDns" Content="Block plaintext DNS" Style="{StaticResource Option}"/>
                <CheckBox Name="CbDisableIPv6" Content="Disable IPv6 egress" Style="{StaticResource Option}"/>
                <CheckBox Name="CbEdgeKill" Content="Enable Edge kill-switch" Style="{StaticResource Option}"/>
                <CheckBox Name="CbDisableQuic" Content="Disable Edge QUIC" Style="{StaticResource Option}"/>
                <CheckBox Name="CbOpenEdge" Content="Open Edge after connection" Style="{StaticResource Option}"/>
                <CheckBox Name="CbFreshState" Content="Fresh Tor state on a new PC" Style="{StaticResource Option}"/>
              </StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Connection tuning" Style="{StaticResource H2}" Margin="0,0,0,16"/>
                <TextBlock Text="SOCKS port" Style="{StaticResource FieldTitle}"/><TextBox Name="TxtSocksPort" Style="{StaticResource Input}" Margin="0,0,0,13"/>
                <TextBlock Text="Routing metric" Style="{StaticResource FieldTitle}"/><TextBox Name="TxtRouteMetric" Style="{StaticResource Input}" Margin="0,0,0,13"/>
                <TextBlock Text="Bootstrap timeout (seconds)" Style="{StaticResource FieldTitle}"/><TextBox Name="TxtBootstrap" Style="{StaticResource Input}" Margin="0,0,0,13"/>
                <CheckBox Name="CbRetry" Content="Retry transient transparent checks" Style="{StaticResource Option}" Margin="0,10,0,8"/>
                <TextBlock Text="Probe attempts (1 - 6)" Style="{StaticResource FieldTitle}"/><TextBox Name="TxtAttempts" Style="{StaticResource Input}" Margin="0,0,0,13"/>
                <TextBlock Text="Probe delay (1 - 20 seconds)" Style="{StaticResource FieldTitle}"/><TextBox Name="TxtProbeDelay" Style="{StaticResource Input}"/>
              </StackPanel></Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
        <!-- Updates -->
        <ScrollViewer Name="PageUpdates" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,10">
            <TextBlock Text="Versions &amp; updates" Style="{StaticResource H1}"/>
            <TextBlock Text="Tor core and Windows Expert Bundle versions differ. Prepare a signed stable bundle, then approve installation after disconnecting. No automatic binary replacements." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,18"/>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Name="UpdateSummary" Text="No update check performed" Style="{StaticResource H2}"/>
              <UniformGrid Columns="3" Margin="0,19,0,20">
                <StackPanel><TextBlock Text="Installed Tor" Style="{StaticResource MutedText}"/><TextBlock Name="InstalledTor" Text="--" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TT.Text}"/></StackPanel>
                <StackPanel><TextBlock Text="Latest core" Style="{StaticResource MutedText}"/><TextBlock Name="LatestTor" Text="--" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TT.Text}"/></StackPanel>
                <StackPanel><TextBlock Text="Windows bundle" Style="{StaticResource MutedText}"/><TextBlock Name="LatestBundle" Text="--" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TT.Text}"/></StackPanel>
              </UniformGrid>
              <TextBlock Name="UpdateNotes" Text="Checking update information requires an Internet connection." Foreground="{DynamicResource TT.Muted}" TextWrapping="Wrap" Margin="0,0,0,15"/>
              <Border Background="{DynamicResource TT.SurfaceAlt}" CornerRadius="12" Padding="15" Margin="0,15,0,15">
                <StackPanel>
                  <DockPanel LastChildFill="True" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Name="BtnInventory" Content="Refresh status" Style="{StaticResource BaseButton}" Margin="12,0,0,0"/>
                    <TextBlock Text="COMPONENT READINESS" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <TextBlock Name="InventorySummary" Text="Checking installed components..." Foreground="{DynamicResource TT.Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                  <UniformGrid Columns="3" Margin="0,0,0,12">
                    <Border Margin="0,0,8,8" Padding="11" CornerRadius="10" Background="{DynamicResource TT.Surface}"><DockPanel><Border Name="ChipTor" DockPanel.Dock="Right" CornerRadius="8" Padding="8,4"><TextBlock Name="StateTor" Text="Checking" FontWeight="SemiBold" FontSize="11"/></Border><TextBlock Text="Tor" VerticalAlignment="Center" Foreground="{DynamicResource TT.Text}"/></DockPanel></Border>
                    <Border Margin="0,0,8,8" Padding="11" CornerRadius="10" Background="{DynamicResource TT.Surface}"><DockPanel><Border Name="ChipLyrebird" DockPanel.Dock="Right" CornerRadius="8" Padding="8,4"><TextBlock Name="StateLyrebird" Text="Checking" FontWeight="SemiBold" FontSize="11"/></Border><TextBlock Text="lyrebird" VerticalAlignment="Center" Foreground="{DynamicResource TT.Text}"/></DockPanel></Border>
                    <Border Margin="0,0,0,8" Padding="11" CornerRadius="10" Background="{DynamicResource TT.Surface}"><DockPanel><Border Name="ChipGeoIP" DockPanel.Dock="Right" CornerRadius="8" Padding="8,4"><TextBlock Name="StateGeoIP" Text="Checking" FontWeight="SemiBold" FontSize="11"/></Border><TextBlock Text="GeoIP" VerticalAlignment="Center" Foreground="{DynamicResource TT.Text}"/></DockPanel></Border>
                    <Border Margin="0,0,8,0" Padding="11" CornerRadius="10" Background="{DynamicResource TT.Surface}"><DockPanel><Border Name="ChipGeoIP6" DockPanel.Dock="Right" CornerRadius="8" Padding="8,4"><TextBlock Name="StateGeoIP6" Text="Checking" FontWeight="SemiBold" FontSize="11"/></Border><TextBlock Text="GeoIP6" VerticalAlignment="Center" Foreground="{DynamicResource TT.Text}"/></DockPanel></Border>
                    <Border Margin="0,0,8,0" Padding="11" CornerRadius="10" Background="{DynamicResource TT.Surface}"><DockPanel><Border Name="ChipTun2socks" DockPanel.Dock="Right" CornerRadius="8" Padding="8,4"><TextBlock Name="StateTun2socks" Text="Checking" FontWeight="SemiBold" FontSize="11"/></Border><TextBlock Text="tun2socks" VerticalAlignment="Center" Foreground="{DynamicResource TT.Text}"/></DockPanel></Border>
                    <Border Padding="11" CornerRadius="10" Background="{DynamicResource TT.Surface}"><DockPanel><Border Name="ChipWintun" DockPanel.Dock="Right" CornerRadius="8" Padding="8,4"><TextBlock Name="StateWintun" Text="Checking" FontWeight="SemiBold" FontSize="11"/></Border><TextBlock Text="Wintun" VerticalAlignment="Center" Foreground="{DynamicResource TT.Text}"/></DockPanel></Border>
                  </UniformGrid>
                  <Border Name="MissingComponentsPanel" Background="{DynamicResource TT.Surface}" CornerRadius="10" Padding="13" Margin="0,0,0,13">
                    <StackPanel>
                      <TextBlock Text="ONLY MISSING COMPONENTS" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TT.Warning}" Margin="0,0,0,7"/>
                      <StackPanel Name="MissingComponentsList"/>
                    </StackPanel>
                  </Border>
                  <TextBlock Text="Ready means the required file was found, not that its signature or live operation was verified. Run Preflight after setup." Foreground="{DynamicResource TT.Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
                  <WrapPanel>
                    <Button Name="BtnProvisionHelpers" Content="Download Wintun + tun2socks" Style="{StaticResource PrimaryButton}"/>
                    <Button Name="BtnImportComponents" Content="Import existing binaries" Style="{StaticResource BaseButton}"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Name="TransferPanel" Background="{DynamicResource TT.SurfaceAlt}" CornerRadius="12" Padding="16" Margin="0,10,0,14" Visibility="Collapsed">
                <StackPanel>
                  <DockPanel LastChildFill="True" Margin="0,0,0,9">
                    <Border DockPanel.Dock="Right" Background="{DynamicResource TT.Glow}" CornerRadius="8" Padding="10,4" Margin="12,0,0,0">
                      <TextBlock Name="TransferStatus" Text="WORKING" Foreground="{DynamicResource TT.Accent}" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="TRANSFER / EXTRACTION PROGRESS" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <TextBlock Name="TransferStage" Text="Starting..." Foreground="{DynamicResource TT.Text}" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"/>
                  <ProgressBar Name="TransferProgress" Height="12" Minimum="0" Maximum="100" Value="0" IsIndeterminate="True" Background="{DynamicResource TT.Surface}" Foreground="{DynamicResource TT.Accent}" BorderThickness="0"/>
                  <TextBlock Name="TransferBytes" Text="Waiting for transfer" Foreground="{DynamicResource TT.Muted}" FontSize="12" Margin="0,10,0,4"/>
                  <TextBlock Name="TransferLocation" Text="No destination written yet." Foreground="{DynamicResource TT.Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,5"/>
                  <TextBlock Name="TransferDescription" Text="" Foreground="{DynamicResource TT.Muted}" TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource TT.SurfaceAlt}" CornerRadius="12" Padding="15" Margin="0,15,0,15">
                <StackPanel>
                  <DockPanel LastChildFill="True"><Border DockPanel.Dock="Right" Name="ChipSignedUpdate" Padding="10,4" CornerRadius="8" Margin="12,0,0,0"><TextBlock Name="StateSignedUpdate" Text="Not staged" FontSize="11" FontWeight="SemiBold"/></Border><TextBlock Text="SIGNED TOR BINARY UPDATE" Style="{StaticResource H2}" VerticalAlignment="Center"/></DockPanel>
                  <TextBlock Name="UpdateStage" Text="Not prepared. Check for updates or download and verify an official signed Windows Expert Bundle." Foreground="{DynamicResource TT.Muted}" Margin="0,9,0,13" TextWrapping="Wrap"/>
                  <WrapPanel>
                    <Button Name="BtnPrepareUpdate" Content="Download + verify signature" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                    <Button Name="BtnImportSignedUpdate" Content="Import signed bundle" Style="{StaticResource BaseButton}" Margin="0,0,8,8"/>
                    <Button Name="BtnInstallUpdate" Content="Install verified update" Style="{StaticResource BaseButton}" Margin="0,0,8,8"/>
                    <Button Name="BtnRollbackUpdate" Content="Rollback Tor version" Style="{StaticResource DangerButton}" Margin="0,0,8,8"/>
                  </WrapPanel>
                  <TextBlock Text="Verifies OpenPGP signatures inside VeylRoute without Gpg4win or another installed program. Official downloads use dist.torproject.org; imported bundles require the matching .asc signature. Windows tar.exe is used for extraction. The original Tor folder is retained for rollback. The tunnel must be stopped before installation or rollback." Foreground="{DynamicResource TT.Muted}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <StackPanel Orientation="Horizontal"><Button Name="BtnUpdates" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Check for updates"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="16" Height="16" Margin="0,0,9,0" Stretch="Uniform" SnapsToDevicePixels="True"><Canvas Width="24" Height="24"><Path Data="M20,7 A8,8 0 0 0 6,5 M6,5 L6,10 M6,5 L11,5 M4,17 A8,8 0 0 0 18,19 M18,19 L18,14 M18,19 L13,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.85" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Name="LblBtnUpdates" Text="Check for updates" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button><Button Name="BtnTorReleases" Style="{StaticResource BaseButton}" AutomationProperties.Name="Official release page"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="16" Height="16" Margin="0,0,9,0" Stretch="Uniform" SnapsToDevicePixels="True"><Canvas Width="24" Height="24"><Path Data="M14,4 L20,4 20,10 M20,4 L10,14 M20,13 L20,20 4,20 4,5 11,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.85" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Name="LblBtnTorReleases" Text="Official release page" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button></StackPanel>
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
        <!-- Activity -->
        <Grid Name="PageActivity" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="Activity &amp; diagnostics" Style="{StaticResource H1}"/>
          <Grid Grid.Row="1" Margin="0,9,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Name="LogHeader" Text="Latest background operation will appear here." Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap"/><TextBlock Name="LogSeveritySummary" Text="Information, progress, warnings and errors are tagged in the live view." Foreground="{DynamicResource TT.Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Name="BtnCopyLog" Style="{StaticResource BaseButton}" AutomationProperties.Name="Copy log"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="16" Height="16" Margin="0,0,9,0" Stretch="Uniform" SnapsToDevicePixels="True"><Canvas Width="24" Height="24"><Path Data="M8,8 L20,8 20,21 8,21 Z M4,16 L4,3 16,3 16,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.85" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Name="LblBtnCopyLog" Text="Copy log" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button><Button Name="BtnOpenLogFolder" Style="{StaticResource BaseButton}" AutomationProperties.Name="Open log folder"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="16" Height="16" Margin="0,0,9,0" Stretch="Uniform" SnapsToDevicePixels="True"><Canvas Width="24" Height="24"><Path Data="M3,7 L3,20 21,20 21,9 11,9 9,6 3,6 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.85" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Name="LblBtnOpenLogFolder" Text="Open log folder" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button></StackPanel>
          </Grid>
          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="5">
            <TextBox Name="TxtLog" Style="{StaticResource Input}" Text="No diagnostic operation selected. Run Status or Health Check to populate this view." IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" Background="{DynamicResource TT.Surface}" BorderThickness="0" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto"/>
          </Border>
        </Grid>
        <!-- Maintenance -->
        <ScrollViewer Name="PageMaintenance" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,10">
            <TextBlock Text="Installation maintenance" Style="{StaticResource H1}"/>
            <TextBlock Text="Support scripts can be hidden from Explorer without changing their paths. The original attributes are recorded for restoration." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,18"/>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Root folder visibility" Style="{StaticResource H2}"/>
              <TextBlock Text="The Tor, tun2socks, config, runtime and emergency-reset components stay in place. This does not move or delete files." Style="{StaticResource MutedText}" Margin="0,7,0,16" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal"><Button Name="BtnTidy" Style="{StaticResource BaseButton}" AutomationProperties.Name="Declutter Explorer"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="16" Height="16" Margin="0,0,9,0" Stretch="Uniform" SnapsToDevicePixels="True"><Canvas Width="24" Height="24"><Path Data="M3,7 L3,20 21,20 21,9 11,9 9,6 3,6 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.85" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Name="LblBtnTidy" Text="Declutter Explorer" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button><Button Name="BtnUntidy" Style="{StaticResource BaseButton}" AutomationProperties.Name="Restore visibility"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="16" Height="16" Margin="0,0,9,0" Stretch="Uniform" SnapsToDevicePixels="True"><Canvas Width="24" Height="24"><Path Data="M2,12 C5,7 8,5 12,5 C16,5 19,7 22,12 C19,17 16,19 12,19 C8,19 5,17 2,12 Z M9,12 A3,3 0 1 1 15,12 A3,3 0 1 1 9,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.85" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Name="LblBtnUntidy" Text="Restore visibility" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button></StackPanel>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
              <TextBlock Text="Recovery" Style="{StaticResource H2}"/>
              <TextBlock Text="The existing Stop and emergency recovery scripts remain the authority for restoring Windows routes and filters. This GUI never disables protections to hide an error." Style="{StaticResource MutedText}" Margin="0,7,0,13" TextWrapping="Wrap"/>
              <Button Name="BtnRecoveryMaintenance" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" AutomationProperties.Name="Run controlled recovery"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="16" Height="16" Margin="0,0,9,0" Stretch="Uniform" SnapsToDevicePixels="True"><Canvas Width="24" Height="24"><Path Data="M9,4 L4,9 9,14 M4,9 L14,9 A7,7 0 1 1 8,20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.85" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Name="LblBtnRecoveryMaintenance" Text="Run controlled recovery" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button>
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <!-- Shared footer -->
      <Border Grid.Row="2" Background="{DynamicResource TT.Sidebar}" BorderBrush="{DynamicResource TT.Border}" BorderThickness="0,1,0,0">
        <Grid Margin="28,0,28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Name="FooterText" Text="Ready. Changes are saved explicitly and apply on the next connection." FontSize="12" Foreground="{DynamicResource TT.Muted}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
            <Button Name="BtnReload" Style="{StaticResource BaseButton}" Height="35" MinWidth="78" AutomationProperties.Name="Reload"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="16" Height="16" Margin="0,0,9,0" Stretch="Uniform" SnapsToDevicePixels="True"><Canvas Width="24" Height="24"><Path Data="M20,7 A8,8 0 0 0 6,5 M6,5 L6,10 M6,5 L11,5 M4,17 A8,8 0 0 0 18,19 M18,19 L18,14 M18,19 L13,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.85" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Name="LblBtnReload" Text="Reload" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button>
            <Button Name="BtnSave" Style="{StaticResource PrimaryButton}" Height="35" MinWidth="145" Margin="0" AutomationProperties.Name="Save configuration"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="16" Height="16" Margin="0,0,9,0" Stretch="Uniform" SnapsToDevicePixels="True"><Canvas Width="24" Height="24"><Path Data="M4,3 L18,3 21,6 21,21 3,21 3,3 Z M7,3 L7,10 17,10 17,3 M7,21 L7,14 17,14 17,21" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.85" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Name="LblBtnSave" Text="Save configuration" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
