#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Package-safe entry point for both Debian installation and portable source tree."""
import os
import sys
from pathlib import Path

here = Path(__file__).resolve()
if here.parent == Path('/usr/bin'):
    sys.path.insert(0, '/usr/lib/veylroute')
else:
    sys.path.insert(0, str(here.parent.parent))
from veylroute.app import main

if __name__ == '__main__':
    raise SystemExit(main())
